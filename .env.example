# ==========================================
# DIU Course Registration Platform - Environment Configuration
# ==========================================

# Supabase Cloud Configuration
# CRITICAL: These must be configured in Vercel Project Settings -> Environment Variables for production
# deployments. Missing NEXT_PUBLIC_* variables at build time cause client bundle DNS lookup failures.
NEXT_PUBLIC_SUPABASE_URL=https://gbobcwnumspimegiqzom.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_f4AaftynNAgxZFCkMJhDcg_j7SFj7Ha
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_f4AaftynNAgxZFCkMJhDcg_j7SFj7Ha
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct PostgreSQL Connection (Optional: Used for server-side migrations & Prisma/Drizzle)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.gbobcwnumspimegiqzom.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.gbobcwnumspimegiqzom.supabase.co:5432/postgres

# Application Base URL (Used for OAuth redirects, consent links, and canonical privacy/terms)
# For local development: http://localhost:3000
# For production: https://courseregdiu.asf.run (or your custom domain)
NEXT_PUBLIC_APP_URL=https://courseregdiu.asf.run

# Institutional Identity Policy
# Only institutional Google accounts matching this domain can register or access academic roles
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=diu.edu.bd

# Resend Email Integration
# Obtain from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM="DIU Course Registration <noreply@registration.diu.edu.bd>"

# Node Environment
NODE_ENV=development
